Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /quiz/

  # Serve real files and directories normally.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Let React Router handle routes such as /quiz/en.
  RewriteRule ^ index.html [L]
</IfModule>
